# Environment variables — copy this file to `.env` and adjust as needed.

# Required: SQLite database URL (local file path)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Required in PRODUCTION (NODE_ENV=production): session signing secret.
# The server FAILS CLOSED in production if this is missing or < 32 chars.
# In development, an insecure fallback is used with a loud warning.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional: GitHub personal access token for live repository metadata retrieval.
# Without this, GitHub URLs are stored as submitted (not validated).
GITHUB_TOKEN=

# Optional: AI provider for resume bullet refinement (deterministic generator runs without it).
AI_PROVIDER_API_KEY=
AI_MODEL=

# Demo mode flag (clearly labels seeded data in the UI)
DEMO_MODE=true

# Optional: override the Node environment. Production is the default for builds.
# Set to "development" for local dev work.
NODE_ENV=development
